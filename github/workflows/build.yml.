name: Build Telegram APK
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Clone Telegram
        run: git clone --depth 1 https://github.com/DrKLO/Telegram.git telegram-src
      - name: Apply Patches
        run: |
          cp CameraView.java telegram-src/TMessagesProj/src/main/java/org/telegram/messenger/camera/CameraView.java
          cp LaunchActivity.java telegram-src/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle
      - name: Build APK
        run: |
          cd telegram-src
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: Telegram-VCam-Debug
          path: telegram-src/TMessagesProj/build/outputs/apk/debug/*.apk
